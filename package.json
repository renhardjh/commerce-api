{
  "name": "commerce-api",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for an online store: catalog, cart, checkout, vouchers and payment callbacks.",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "knex migrate:latest",
    "seed": "knex seed:run",
    "setup": "npm run migrate && npm run seed",
    "expire-orders": "node scripts/expire-orders.js",
    "sign-webhook": "node scripts/sign-webhook.js",
    "test": "NODE_ENV=test node --test --test-concurrency=1 'test/**/*.test.js'"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.2.0",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.2"
  }
}
